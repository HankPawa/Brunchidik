# Copia este archivo como .env y completa los valores.
# Ninguna de estas claves tiene valor por defecto en el codigo:
# si falta una obligatoria, el servidor no arranca y te dice cual.

# Puerto del backend (opcional, por defecto 8080)
PORT=8080

# PostgreSQL (obligatorio). Formato:
# postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
DATABASE_URL=

# Firma de los tokens de sesion (obligatorio, minimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis (opcional). Si lo dejas vacio, el rate limiting y los codigos 2FA
# se guardan en memoria del proceso (valido para desarrollo).
REDIS_URL=

# Origenes permitidos por CORS, separados por coma (opcional)
CORS_ORIGINS=http://localhost:5173

# Correo SMTP (opcional). Sin estos valores no se envian codigos 2FA
# ni confirmaciones de reserva; el codigo 2FA se imprime en la consola.
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=onboarding@resend.dev

# Client ID de Google OAuth (opcional, recomendado): el mismo valor que
# VITE_GOOGLE_CLIENT_ID del frontend. Con el se verifica que el token de
# Google se haya emitido para esta app.
GOOGLE_CLIENT_ID=

# Administrador que crea `npm run seed` (obligatorios para la semilla)
ADMIN_EMAIL=
ADMIN_PASSWORD=
