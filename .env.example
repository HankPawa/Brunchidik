# Este archivo solo lo usa docker-compose.
# Para desarrollo local (npm run dev) la configuracion vive en api/.env.
#
# Copia este archivo como .env y completa los valores.

# PostgreSQL del contenedor
POSTGRES_DB=brunch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Firma de los tokens de sesion (minimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origen desde el que se sirve el frontend
CORS_ORIGINS=http://localhost

# Correo SMTP (opcional). Sin esto no se envian codigos 2FA ni confirmaciones.
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=onboarding@resend.dev

# Google OAuth: mismo Client ID para backend y frontend
GOOGLE_CLIENT_ID=

# Administrador inicial que crea la semilla
ADMIN_EMAIL=
ADMIN_PASSWORD=
