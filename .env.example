# Perfil de Spring Boot: local | neon
SPRING_PROFILE=neon

# Base de datos (requerido cuando SPRING_PROFILE=neon)
DB_URL=jdbc:postgresql://ep-xxx.neon.tech/brunch_db?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_db_password_here

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ORIGINS=http://localhost

# Puerto del backend (opcional, default 8080)
PORT=8080
